# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Default claude-opus-5. claude-sonnet-5 and claude-haiku-4-5 are
# cheaper; see README -> Costs for what you give up.
PARSE_MODEL=

# Required once deployed. Leave unset for local dev.
APP_PASSWORD=

# --- Morning digest (optional; the 8am cron no-ops without these) ---
# resend.com -> API keys. Free tier is 100 emails/day.
RESEND_API_KEY=
DIGEST_TO=you@example.com
# Needs a verified domain to change. The default only delivers to your own
# Resend account address.
DIGEST_FROM="My Todos <onboarding@resend.dev>"
# Vercel -> Settings -> Environment Variables. Any random string.
CRON_SECRET=
# Put in the digest email so you can tap through.
APP_URL=
